{
  "manifest_version": 3,
  "name": "Kidnap",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "Detect, preview and download images, video, audio, streams and documents from any page. Runs entirely on your machine.",
  "homepage_url": "https://github.com/kidnap/kidnap",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "contextMenus",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kidnap",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "sandbox": {
    "pages": ["sandbox/convert.html"]
  }
}
