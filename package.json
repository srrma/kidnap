{
  "name": "kidnap",
  "version": "3.0.0",
  "description": "Detect, preview and download media from any page. Runs entirely on your machine.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "mediabunny": "^1.55.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.6.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
